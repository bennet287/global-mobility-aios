# API
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+psycopg://gmai:gmai_password@postgres:5432/gmai

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=global_mobility_memory

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=gmai-documents
MINIO_SECURE=false

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# LLM local endpoint; optional
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LOCAL_MODEL=qwen2.5:7b

# Security
JWT_SECRET=change-this-in-production
TRUTH_ENGINE_STRICT_MODE=true

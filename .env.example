# API
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_ALLOW_HEADER_ROLE=true  # local-development shortcut only; code default is false
NEXT_PUBLIC_GMAI_ROLE=admin
NEXT_PUBLIC_GMAI_USER=frontend-operator

# Database
DATABASE_URL=postgresql+psycopg://gmai:gmai_password@postgres:5432/gmai
DATABASE_AUTO_CREATE_TABLES=false
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=global_mobility_memory

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=gmai-documents
MINIO_SECURE=false
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_LOCAL_STORAGE_DIR=storage/documents
DOCUMENT_UPLOAD_MAX_MB=25

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# LLM local endpoint; optional
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LOCAL_MODEL=qwen2.5:7b

# Remote LLM providers (set one at a time; leave LLM_PROVIDER empty to use deterministic templates)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k1-5
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_FALLBACK_TO_TEMPLATE=true

# OpenTelemetry — optional vendor-neutral telemetry (Technology Radar V1.1 Wave 1 pilot).
# Disabled by default. When enabled, packages must be installed; missing packages are a no-op.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=global-mobility-aios-api
OTEL_SERVICE_VERSION=0.1.0

# ClamAV — optional upload malware scanning (Technology Radar V1.1 Wave 1 pilot).
# Disabled by default. Requires a running clamd daemon reachable at CLAMAV_HOST:CLAMAV_PORT.
# When CLAMAV_BLOCK_ON_SCANNER_ERROR=true, missing/unreachable clamd blocks uploads.
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_BLOCK_ON_SCANNER_ERROR=false

# Docling — optional document normalization / structured understanding pilot
# (Technology Radar V1.1 Wave 2). Disabled by default. Install docling from
# requirements-ai.txt before enabling; the adapter degrades gracefully if the
# package is missing or conversion fails.
DOCLING_ENABLED=false

# Security
JWT_SECRET=change-this-in-production
AUTH_ENABLED=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-this
AUTH_SESSION_COOKIE=gmai_session
AUTH_ALLOW_HEADER_ROLE=true  # local-development shortcut only; code default is false
TRUTH_ENGINE_STRICT_MODE=true
SOURCE_MONITOR_TIMEOUT_SECONDS=30
SOURCE_MONITOR_MAX_BYTES=5000000
SOURCE_MONITOR_ALLOW_HTTP=false
REGULATORY_MODEL_CLASSIFICATION_ENABLED=false
COVERAGE_TRANCHE_ASSISTANT_ENABLED=false
COVERAGE_TRANCHE_ASSISTANT_MAX_ITEMS=25

# Signed, expiring document access (local defaults)
DOCUMENT_ACCESS_TOKEN_SECRET=change-this-separate-document-access-secret
DOCUMENT_ACCESS_DEFAULT_TTL_SECONDS=300
DOCUMENT_ACCESS_MAX_TTL_SECONDS=900
DOCUMENT_ACCESS_DEFAULT_MAX_USES=1
DOCUMENT_ACCESS_MAX_USES=5
DOCUMENT_STORAGE_PRODUCTION_STRICT=false
DOCUMENT_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=false
MINIO_AUTO_CREATE_BUCKET=true
MINIO_SERVER_SIDE_ENCRYPTION=true
DOCUMENT_STORAGE_RETENTION_DAYS=0
DOCUMENT_STORAGE_BACKUP_STRATEGY=
DOCUMENT_STORAGE_RECOVERY_TESTED_AT=

# Runtime
APP_ENV=production
LOG_LEVEL=INFO
API_PORT=8000
CORS_ALLOWED_ORIGINS=https://change-this-web-origin.example

# PostgreSQL container settings
POSTGRES_USER=gmai
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=gmai
POSTGRES_PORT=5432

# API database URL inside Docker network
DATABASE_URL=postgresql+psycopg://gmai:change-this-postgres-password@postgres:5432/gmai
DATABASE_AUTO_CREATE_TABLES=false
DATABASE_ECHO=false

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
AUTH_ENABLED=true
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-this-admin-password
AUTH_SESSION_COOKIE=gmai_session
AUTH_ALLOW_HEADER_ROLE=false

# Optional services remain configured but are not started by v3.3 production compose.
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=global_mobility_memory
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=gmai-documents
MINIO_SECURE=false
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_LOCAL_STORAGE_DIR=storage/documents
DOCUMENT_UPLOAD_MAX_MB=25
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LOCAL_MODEL=qwen2.5:7b
TRUTH_ENGINE_STRICT_MODE=true
SOURCE_MONITOR_TIMEOUT_SECONDS=30
SOURCE_MONITOR_MAX_BYTES=5000000
SOURCE_MONITOR_ALLOW_HTTP=false

# Remote LLM providers (set one at a time; leave LLM_PROVIDER empty to use deterministic templates)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k1-5
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_FALLBACK_TO_TEMPLATE=true

# Public URL reachable by GitHub webhooks. For local-only testing use a secure tunnel
# or a small public reverse proxy endpoint; do not expose the Docker socket.
WOODPECKER_HOST=https://ci.example.com

# GitHub username allowed to administer this Woodpecker instance.
WOODPECKER_ADMIN=bennet287

# Create a GitHub OAuth app with callback URL:
#   ${WOODPECKER_HOST}/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Generate locally, for example: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=

# Parallel workflow cap for the local runner. Four matches the four independent CI lanes.
WOODPECKER_MAX_WORKFLOWS=4
